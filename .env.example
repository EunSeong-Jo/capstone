# ─────────────────────────────────────────────────────────
# swappy — 로컬 개발 환경 변수
# 이 파일을 복사해서 .env로 저장 후 값을 채워주세요.
#   cp .env.example .env
#
# 표기 규칙
#   KEY=값        자주 바꾸거나 반드시 채워야 하는 값
#   # KEY=값      선택 항목. 주석의 값은 코드 기본값(backend/app/config.py)이라
#                 주석을 풀지 않아도 같은 값으로 동작한다. 바꿀 때만 주석을 푼다.
# 비밀값(키·DSN·비밀번호)은 이 파일이 아니라 .env에만 넣는다(.env는 커밋하지 않는다).
# ─────────────────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
# 로그 수준: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ── 인증 (JWT) ──────────────────────────────────────────
# 액세스 토큰은 무효화할 방법이 없어(서명만 검증) 짧게, 리프레시는 DB에 해시로 남아 즉시 끊을 수 있다.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14

# ── PostgreSQL (필수) ────────────────────────────────────
# ★ 이 한 줄이 비면 제품 API가 전부 실패합니다. 반드시 채워 주세요.
#   (비어 있으면 서버 기동 로그에 안내 문구가 크게 출력됩니다)
#
# 팀 공용 DB는 Neon입니다.
#   Neon 콘솔(https://console.neon.tech) → 조직 dmu → capstone 프로젝트
#   → Connection string 복사 → 아래에 붙여넣기
# DATABASE_DSN=postgresql://<user>:<password>@ep-xxxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Neon 덤프를 복원한 로컬 Postgres를 쓸 때(논문 분석 스크립트는 로컬 DB만 허용 — paper_common.require_local)
# DATABASE_DSN=postgresql://swappy:swappy_dev@localhost:5432/swappy
DATABASE_DSN=

# ── 아래는 DATABASE_DSN이 비었을 때만 사용됩니다 ─────────
# 즉 `docker compose --profile local-db up` 으로 로컬 postgres를 띄울 때뿐입니다.
# 그 컨테이너는 빈 DB라 alembic upgrade head + 시드 스크립트를 따로 돌려야 합니다.
POSTGRES_HOST=postgres
POSTGRES_DB=swappy
POSTGRES_USER=swappy
POSTGRES_PASSWORD=swappy_dev
POSTGRES_PORT=5432

# DB 연결 유지 핑(30초 간격 SELECT 1). 켜면 Neon이 꺼지지 않아 CU-hrs를 계속 쓴다.
# 개발 중에는 false(기본)로 두세요. 상시 운영 서버에서만 true.
DB_KEEPALIVE=false

# ── Redis ────────────────────────────────────────────────
# 호스트는 Docker 컨테이너명. Docker 없이 로컬에서 돌리면 localhost.
# REDIS_HOST=redis
REDIS_PORT=6379

# ── 포트 · 서빙 ─────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
# CORS 허용 출처(프론트 주소)
# FRONTEND_URL=http://localhost:3000
# 프론트 빌드 결과(dist) 경로. 채우면 백엔드가 정적 파일까지 서빙한다(단독 실행용). 비우면 끈다.
# STATIC_DIR=

# ── 프론트엔드 ───────────────────────────────────────────
# Docker 없이 `npm run dev`로 돌릴 때만 쓰는 값입니다.
# docker compose는 이 값을 무시하고 http://backend:8000 을 고정으로 씁니다
# (컨테이너 안에서 localhost는 자기 자신이라 백엔드가 아닙니다).
VITE_API_BASE_URL=http://localhost:8000
# 로그인 화면의 '데모 계정으로 바로 로그인' 패널 기본값. 비우면 숨김(기본). on이면 처음부터 표시(개발용). 로고를 7번 연달아 누르면 기기에서 켜고 끌 수 있다.
# VITE_DEMO_PANEL=on
# 제품 조회 실패 시 실 API 캡처본(mocks/products.fixture.json)으로 폴백할지.
# 비우면 `npm run dev`에서만 폴백한다. docker-compose는 false를 명시로 주입한다(frontend/src/hooks/useProducts.ts).
# VITE_MOCK_FALLBACK=false

# ── Sentry (P0 모니터링) — 선택사항 ─────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
SENTRY_DSN=

# ── 챗봇 LLM ────────────────────────────────────────────
# LLM_CHAIN 순서로 시도하고, 하나가 실패(키 만료·한도·타임아웃)하면 다음으로 넘어간다.
# 전부 실패하면 챗봇은 DB 기반 답변(services/chat/chat_fallback.py)으로 대신한다 — 키가 없어도 동작한다.
LLM_PROVIDER=openai
LLM_CHAIN=openai,claude
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...여기에_실제_키_입력...
# CLAUDE_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# 공급자 한 곳당 응답 대기(초)
# LLM_TIMEOUT=20.0
# 로컬 개발용(선택): Ollama의 OpenAI 호환 주소를 주면 체인 끝에 붙는다
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.2:3b

# 퍼스널 AI(챗봇이 내 화장대·피부 상태를 앎). 문제가 생기면 false로 예전 챗봇으로 돌아간다.
# PERSONAL_AI_ENABLED=true
# 로그인 사용자 챗봇의 도구 호출(대체품·궁합·예산 루틴·담기 제안). false면 도구 없는 챗봇.
# CHAT_TOOLS_ENABLED=true

# 챗봇 비회원 호출 제한 — IP당 하루 횟수 (POST /api/v1/chat)
GUEST_CHAT_DAILY_LIMIT=3
# 프록시·로드밸런서 뒤에 배포할 때만 true. X-Forwarded-For의 첫 주소로 IP를 센다.
# 프록시 없이 켜면 누구나 헤더를 바꿔 제한을 피할 수 있다.
TRUST_PROXY_HEADERS=false

# ── 날씨 (홈 대시보드) ────────────────────────────────────
# https://openweathermap.org/api 가입 후 무료 티어 키 발급 (분당 60회)
# 비어 있으면 /api/v1/weather가 503을 내고, 프론트는 목업 날씨로 대체 표시합니다.
OPENWEATHER_API_KEY=

# ── 사진으로 화장품 찾기 (POST /api/v1/products/scan) — 네이버 CLOVA OCR(General) ──
# research/ocr/CLOVA_OCR/.env와 같은 값. 비어 있으면 스캔 화면이 제품명 검색으로 안내한다.
CLOVA_OCR_SECRET=
CLOVA_OCR_INVOKE_URL=
# 스캔 호출 한도(CLOVA 무료 한도 보호, services/scan/ocr_quota.py). 허용 계정(쉼표로 구분한 이메일)은 면제,
# 나머지는 하루(서울 날짜) 계정당·전체 한도. 초과하면 429.
# OCR_ALLOWED_EMAILS=
# OCR_USER_DAILY_LIMIT=3
# OCR_GLOBAL_DAILY_LIMIT=15

# ── 얼굴 사진 AI 피부 분석 (POST /api/v1/skin-analysis) — Perfect Corp YouCam Skin Analysis ──
# 키는 https://yce.makeupar.com/api-console 에서 발급한다. **호출은 유닛을 쓴다**
# (SD 기준 5~8개 유형 12유닛, 9~12개 14유닛). 개발·테스트는 PERFECT_CORP_MOCK=true로
# 저장해 둔 응답을 쓰면 유닛이 들지 않는다. 키가 없고 MOCK도 아니면 분석 API가 503을 내며,
# 화면은 QnA만으로 진단을 이어 간다.
PERFECT_CORP_API_KEY=
PERFECT_CORP_MOCK=false
# PERFECT_CORP_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0
# sd | hd — 같은 사진에서 점수가 거의 같고 SD가 더 싸다. 기본 sd.
PERFECT_CORP_MODE=sd
# 실제로 Perfect Corp을 부를 수 있는 계정(쉼표로 구분한 이메일). 그 밖의 계정은 외부 호출 없이
# SKIN_SAMPLE_EMAIL 계정에 저장된 분석 결과를 자기 분석으로 받는다(한도·동의는 똑같이 적용).
SKIN_ANALYSIS_ALLOWED_EMAILS=capstone@gmail.com
SKIN_SAMPLE_EMAIL=eunseong@swappy.app
# 구독 중이어도 무료와 같은 기본 8항목만 분석할 계정(쉼표로 구분, 시연용). 월 이용 횟수는 구독 그대로.
# SKIN_BASIC_ITEMS_EMAILS=
# 월 이용 한도(월 경계 Asia/Seoul). 무료는 사진 수집 동의자만, 구독은 동의 + 활성 구독.
# SKIN_FREE_MONTHLY=1
# SKIN_SUBSCRIBER_MONTHLY=4
# 사진 점수를 QnA에 섞는 비중(0~1). 사진을 쓰지 않은 진단은 항상 QnA 100%.
PHOTO_BLEND_WEIGHT=0.4
# 일부 문항만 답하고 촬영한 진단에서, 답한 문항이 건드린 축의 사진 비중(0~1). 건드리지 않은 축은 사진 100%.
# PHOTO_PARTIAL_WEIGHT=0.5
# 사진 점수 → 5축 변환 보정(services/skin_photo.to_axes). 기본은 보정 없음.
# PHOTO_AXIS_GAIN=1.0
# PHOTO_SKIN_TYPE_NUDGE=1.0
# 얼굴 사진 수집 동의 문구 버전. 문구(개인정보 처리방침)를 바꾸면 함께 올린다.
# FACE_CONSENT_VERSION=2026-10-26

# 얼굴 사전 필터 임계값(services/photo/face_gate.py · services/photo/occlusion.py). 거절 로그와 실제 사진으로 조정한다.
# 각 값의 근거(시험 사진 실측치)는 backend/app/config.py 주석 참고.
# 검출 신뢰도
# FACE_MIN_SCORE=0.8
# 얼굴 폭(눈 사이 거리로 어림) ÷ 사진 폭, 눈 위치를 못 얻을 때는 검출 상자 폭 기준
# FACE_MIN_WIDTH_RATIO=0.60
# FACE_MIN_BOX_RATIO=0.40
# 정면: 눈 선 기울기(도)와 코끝 좌우 치우침(눈 사이 거리 대비)
# FACE_MAX_ROLL_DEG=15.0
# FACE_MAX_YAW_OFFSET=0.12
# 조명: 너무 밝음·너무 어두움·좌우 밝기 차 ÷ 평균
# FACE_MAX_LUMINANCE=200.0
# FACE_MIN_LUMINANCE=50.0
# FACE_MAX_LIGHT_IMBALANCE=0.4
# 초점: 라플라시안 분산
# FACE_MIN_SHARPNESS=60.0
# 가림: 영역별 얼굴 피부 비율
# FACE_SKIN_MIN_CHEEK=0.70
# FACE_SKIN_MIN_NOSE_MOUTH=0.80
# FACE_SKIN_MIN_CHIN=0.60

# ── 논문 분석 스크립트 (scripts/paper/) ──────────────────
# 식품의약품안전처 공공데이터 API 인증키 — 공공데이터포털(data.go.kr) 마이페이지 → 데이터활용 → Open API →
# 활용신청 현황에서 각 데이터의 '일반 인증키(Decoding)'를 복사한다.
# 데이터별 변수를 먼저 읽고, 비어 있으면 공통 MFDS_API_KEY를 쓴다(계정 키가 하나뿐이면 공통 키만 채우면 된다).
# 스크립트는 .env에서 해당 줄만 읽고 키를 출력하지 않는다.
#
# 식품의약품안전처_기능성화장품 보고품목정보 (15095680) — 미표기 제품의 외부 검증 라벨 · scripts/paper/fetch_mfds_functional.py
MFDS_FUNCTIONAL_API_KEY=
# 식품의약품안전처_화장품 사용제한 원료정보 (15111772) — data/seed/usage_limits.csv 공식 대조
MFDS_RESTRICTED_API_KEY=
# 식품의약품안전처_화장품 원료성분정보 — 성분 표준명·영문명으로 성분명 정규화 보강(선택)
MFDS_INGREDIENT_API_KEY=
# 공통 키(선택) — 위 데이터별 키가 비어 있을 때 대신 쓴다
# MFDS_API_KEY=
# 통합 데이터셋 버전(data/paper/derived/<값>). unified_v2는 사용한도 고시 성분을 상한·앵커로 더한 판.
# UNIFIED=unified_v1
# Open Beauty Facts JSONL 경로(scripts/paper/pilot_t1_obf.py). 비우면 세션 임시 폴더 기본값.
# OBF_JSONL=

# ── Task Master AI (MCP 사용 시) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
# PERPLEXITY_API_KEY=pplx-...
