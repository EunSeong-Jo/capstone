# ─────────────────────────────────────────────────────────
# swappy — 로컬 개발 환경 변수
# 이 파일을 복사해서 .env로 저장 후 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# ── PostgreSQL ───────────────────────────────────────────
# 팀 공용 DB는 Neon을 씁니다. DATABASE_DSN 한 줄만 채우면 아래 POSTGRES_*는 무시됩니다.
#
#   Neon 콘솔(https://console.neon.tech) → capstone 프로젝트
#   → Connection string 복사 → 아래에 붙여넣기
#
# DATABASE_DSN=postgresql://<user>:<password>@ep-xxxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_DSN=

# ── 아래는 DATABASE_DSN이 비었을 때만 사용됩니다 ─────────
# Docker Compose 사용 시  : POSTGRES_HOST=postgres  (컨테이너명)
# 로컬 PostgreSQL 설치 시 : POSTGRES_HOST=localhost
POSTGRES_HOST=postgres
POSTGRES_DB=swappy
POSTGRES_USER=swappy
POSTGRES_PASSWORD=swappy_dev
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────
REDIS_PORT=6379

# ── 포트 ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── 프론트엔드 ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Sentry (P0 모니터링) — 선택사항 ─────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
SENTRY_DSN=

# ── 챗봇 LLM ────────────────────────────────────────────
# 현재: OpenAI 사용 (LLM_PROVIDER=openai)
# 9월 이후 Claude 전환 시: LLM_PROVIDER=claude, LLM_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...여기에_실제_키_입력...

# Claude 전환 시 아래 주석 해제
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...


# ── Task Master AI (MCP 사용 시) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
# PERPLEXITY_API_KEY=pplx-...