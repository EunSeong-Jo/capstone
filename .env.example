# ─────────────────────────────────────────────────────────
# swappy — 로컬 개발 환경 변수
# 이 파일을 복사해서 .env로 저장 후 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# ── PostgreSQL (필수) ────────────────────────────────────
# ★ 이 한 줄이 비면 제품 API가 전부 실패합니다. 반드시 채워 주세요.
#   (비어 있으면 서버 기동 로그에 안내 문구가 크게 출력됩니다)
#
# 팀 공용 DB는 Neon이고, 제품·성분 데이터가 여기에만 있습니다.
#   Neon 콘솔(https://console.neon.tech) → 조직 dmu → capstone 프로젝트
#   → Connection string 복사 → 아래에 붙여넣기
#
# DATABASE_DSN=postgresql://<user>:<password>@ep-xxxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_DSN=

# ── 아래는 DATABASE_DSN이 비었을 때만 사용됩니다 ─────────
# 즉 `docker compose --profile local-db up` 으로 로컬 postgres를 띄울 때뿐입니다.
# 그 컨테이너는 빈 DB라 alembic upgrade head + 시드 스크립트를 따로 돌려야 합니다.
POSTGRES_HOST=postgres
POSTGRES_DB=swappy
POSTGRES_USER=swappy
POSTGRES_PASSWORD=swappy_dev
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────
REDIS_PORT=6379

# ── 포트 ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── 프론트엔드 ───────────────────────────────────────────
# Docker 없이 `npm run dev`로 돌릴 때만 쓰는 값입니다.
# docker compose는 이 값을 무시하고 http://backend:8000 을 고정으로 씁니다
# (컨테이너 안에서 localhost는 자기 자신이라 백엔드가 아닙니다).
VITE_API_BASE_URL=http://localhost:8000
# 로그인 화면의 '데모 계정으로 바로 로그인' 패널 기본값. 비우면 숨김(기본). on이면 처음부터 표시(개발용). 로고를 7번 연달아 누르면 기기에서 켜고 끌 수 있다.
# VITE_DEMO_PANEL=on

# ── Sentry (P0 모니터링) — 선택사항 ─────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
SENTRY_DSN=

# ── 챗봇 LLM ────────────────────────────────────────────
# LLM_CHAIN 순서로 시도하고, 하나가 실패(키 만료·한도·타임아웃)하면 다음으로 넘어간다.
# 전부 실패하면 챗봇은 DB 기반 답변(services/chat_fallback.py)으로 대신한다 — 키가 없어도 동작한다.
LLM_PROVIDER=openai
LLM_CHAIN=openai,claude
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...여기에_실제_키_입력...
# CLAUDE_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# 로컬 개발용(선택): Ollama의 OpenAI 호환 주소를 주면 체인 끝에 붙는다
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.2:3b


# ── 날씨 (홈 대시보드) ────────────────────────────────────
# https://openweathermap.org/api 가입 후 무료 티어 키 발급 (분당 60회)
# 비어 있으면 /api/v1/weather가 503을 내고, 프론트는 목업 날씨로 대체 표시합니다.
OPENWEATHER_API_KEY=

# 사진으로 화장품 찾기 (POST /api/v1/products/scan) — 네이버 CLOVA OCR(General)
# scripts/CLOVA_OCR/.env와 같은 값. 비어 있으면 스캔 화면이 제품명 검색으로 안내한다.
CLOVA_OCR_SECRET=
CLOVA_OCR_INVOKE_URL=

# 얼굴 사진 AI 피부 분석 (POST /api/v1/skin-analysis) — Perfect Corp YouCam Skin Analysis
# 키는 https://yce.makeupar.com/api-console 에서 발급한다. **호출은 유닛을 쓴다**
# (SD 기준 5~8개 유형 12유닛, 9~12개 14유닛). 개발·테스트는 PERFECT_CORP_MOCK=true로
# 저장해 둔 응답을 쓰면 유닛이 들지 않는다. 키가 없고 MOCK도 아니면 분석 API가 503을 내며,
# 화면은 QnA만으로 진단을 이어 간다.
PERFECT_CORP_API_KEY=
PERFECT_CORP_MOCK=false
# sd | hd — 같은 사진에서 점수가 거의 같고 SD가 더 싸다. 기본 sd.
PERFECT_CORP_MODE=sd
# 사진 점수를 QnA에 섞는 비중(0~1). 사진을 쓰지 않은 진단은 항상 QnA 100%.
PHOTO_BLEND_WEIGHT=0.4


# ── Task Master AI (MCP 사용 시) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
# PERPLEXITY_API_KEY=pplx-...

# 챗봇 비회원 호출 제한 — IP당 하루 횟수 (POST /api/v1/chat)
GUEST_CHAT_DAILY_LIMIT=3
# 프록시·로드밸런서 뒤에 배포할 때만 true. X-Forwarded-For의 첫 주소로 IP를 센다.
# 프록시 없이 켜면 누구나 헤더를 바꿔 제한을 피할 수 있다.
TRUST_PROXY_HEADERS=false

# DB 연결 유지 핑(30초 간격 SELECT 1). 켜면 Neon이 꺼지지 않아 CU-hrs를 계속 쓴다.
# 개발 중에는 false(기본)로 두세요. 상시 운영 서버에서만 true.
DB_KEEPALIVE=false
