# ─────────────────────────────────────────────────────────
# swappy — 로컬 개발 환경 변수
# 이 파일을 복사해서 .env로 저장 후 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# ── PostgreSQL (필수) ────────────────────────────────────
# ★ 이 한 줄이 비면 제품 API가 전부 실패합니다. 반드시 채워 주세요.
#   (비어 있으면 서버 기동 로그에 안내 문구가 크게 출력됩니다)
#
# 팀 공용 DB는 Neon이고, 제품·성분 데이터가 여기에만 있습니다.
#   Neon 콘솔(https://console.neon.tech) → 조직 dmu → capstone 프로젝트
#   → Connection string 복사 → 아래에 붙여넣기
#
# DATABASE_DSN=postgresql://<user>:<password>@ep-xxxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_DSN=

# ── 아래는 DATABASE_DSN이 비었을 때만 사용됩니다 ─────────
# 즉 `docker compose --profile local-db up` 으로 로컬 postgres를 띄울 때뿐입니다.
# 그 컨테이너는 빈 DB라 alembic upgrade head + 시드 스크립트를 따로 돌려야 합니다.
POSTGRES_HOST=postgres
POSTGRES_DB=swappy
POSTGRES_USER=swappy
POSTGRES_PASSWORD=swappy_dev
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────
REDIS_PORT=6379

# ── 포트 ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── 프론트엔드 ───────────────────────────────────────────
# Docker 없이 `npm run dev`로 돌릴 때만 쓰는 값입니다.
# docker compose는 이 값을 무시하고 http://backend:8000 을 고정으로 씁니다
# (컨테이너 안에서 localhost는 자기 자신이라 백엔드가 아닙니다).
VITE_API_BASE_URL=http://localhost:8000

# ── Sentry (P0 모니터링) — 선택사항 ─────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
SENTRY_DSN=

# ── 챗봇 LLM ────────────────────────────────────────────
# 현재: OpenAI 사용 (LLM_PROVIDER=openai)
# 9월 이후 Claude 전환 시: LLM_PROVIDER=claude, LLM_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...여기에_실제_키_입력...

# Claude 전환 시 아래 주석 해제
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...


# ── 날씨 (홈 대시보드) ────────────────────────────────────
# https://openweathermap.org/api 가입 후 무료 티어 키 발급 (분당 60회)
# 비어 있으면 /api/v1/weather가 503을 내고, 프론트는 목업 날씨로 대체 표시합니다.
OPENWEATHER_API_KEY=


# ── Task Master AI (MCP 사용 시) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
# PERPLEXITY_API_KEY=pplx-...