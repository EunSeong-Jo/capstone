# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicit text types
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.py text
*.ts text
*.tsx text
*.js text
*.jsx text
*.css text
*.html text
*.sh text
*.env.example text

# 데이터 파일
# CSV는 평문으로 커밋해 PR에서 diff를 볼 수 있게 한다. git이 zlib으로 팩하므로
# 미리 gzip해 두는 것보다 저장소가 오히려 작고, 버전이 쌓이면 델타 압축도 걸린다.
# (data/seed/의 성분사전 2종과 data/raw/oliveyoung_products.csv.gz만 .gz다 —
#  seed_ingredients.py가 gzip을 강제하고 load_products.py 기본 경로가 여기다)
*.csv text
*.gz binary

# Binary files should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary
